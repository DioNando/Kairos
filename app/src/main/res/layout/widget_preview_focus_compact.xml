<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du widget 2×1 « Tâche prioritaire » : carte pleine couleur « Faire » — icône + verbe sur
     une ligne, exemple de titre dessous — et ✓. Coins concentriques : extérieur 26 dp, marge 8 dp,
     carte 18 dp. Rendu à la volée = net à toute taille. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="60dp"
    android:background="@drawable/widget_preview_bg_compact"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_card_compact"
        android:backgroundTint="#E5645A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/widget_do"
                    android:tint="#D9FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/quadrant_do"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_task_1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_tile"
            android:backgroundTint="#33FFFFFF"
            android:padding="7dp"
            android:src="@drawable/widget_check" />
    </LinearLayout>
</LinearLayout>
