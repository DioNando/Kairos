<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du widget 2×2 : 4 tuiles, icône seule centrée (pas de chiffre, cohérent avec l'aperçu
     2×1). Rendu à la volée = net à toute taille. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="110dp"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="8dp">

    <!-- Rangée haute : Faire (rouge) + Planifier (teal). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_do"
            android:tint="#FFFFFF"
            android:background="@drawable/widget_preview_tile_grid"
            android:backgroundTint="#E5645A" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_schedule"
            android:tint="#FFFFFF"
            android:background="@drawable/widget_preview_tile_grid"
            android:backgroundTint="#4FA5A0" />
    </LinearLayout>

    <!-- Rangée basse : Déléguer (ambre) + Supprimer (gris). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_delegate"
            android:tint="#FFFFFF"
            android:background="@drawable/widget_preview_tile_grid"
            android:backgroundTint="#E0A24E" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_eliminate"
            android:tint="#FFFFFF"
            android:background="@drawable/widget_preview_tile_grid"
            android:backgroundTint="#9C9AA6" />
    </LinearLayout>
</LinearLayout>
