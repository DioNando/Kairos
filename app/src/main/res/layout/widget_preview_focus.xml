<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du widget « À faire en priorité » : en-tête, carte de la tâche prioritaire (teinte et
     icône « Faire ») avec son ✓, puis deux tâches « À suivre » (icônes Planifier / Déléguer).
     Exemples de titres localisés. Rendu à la volée = net à toute taille. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="150dp"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_focus_title"
            android:textColor="#1D1D1B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tâche prioritaire (Faire). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile"
        android:backgroundTint="#33E5645A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_do"
            android:tint="#E5645A" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_task_1"
            android:textColor="#1D1D1B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_preview_tile"
            android:backgroundTint="#E5645A"
            android:padding="6dp"
            android:src="@drawable/widget_check" />
    </LinearLayout>

    <!-- À suivre : Planifier. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_tile"
        android:backgroundTint="#141D1D1B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_schedule"
            android:tint="#4FA5A0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/widget_preview_task_2"
            android:textColor="#1D1D1B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- À suivre : Déléguer. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_tile"
        android:backgroundTint="#141D1D1B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_delegate"
            android:tint="#E0A24E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/widget_preview_task_3"
            android:textColor="#1D1D1B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
