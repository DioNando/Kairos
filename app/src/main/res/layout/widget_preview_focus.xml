<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du widget « À faire en priorité » : en-tête, carte de la tâche prioritaire (icône + verbe
     « Faire », exemple de titre, ✓), puis deux tâches « À suivre » (icônes Planifier / Déléguer).
     Mêmes proportions que le widget : rayon 26 dp, marges 12 dp (côtés) / 8 dp, cartes 18 dp. Rendu à la volée. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="160dp"
    android:background="@drawable/widget_preview_bg_compact"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_focus_title"
            android:textColor="#1D1D1B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tâche prioritaire (Faire). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_card_compact"
        android:backgroundTint="#33E5645A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/widget_do"
                    android:tint="#E5645A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/quadrant_do"
                    android:textColor="#E5645A"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_task_1"
                android:textColor="#1D1D1B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_tile"
            android:backgroundTint="#E5645A"
            android:padding="7dp"
            android:src="@drawable/widget_check" />
    </LinearLayout>

    <!-- À suivre : Planifier. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_card_compact"
        android:backgroundTint="#141D1D1B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_schedule"
            android:tint="#4FA5A0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:text="@string/widget_preview_task_2"
            android:textColor="#1D1D1B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- À suivre : Déléguer. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_card_compact"
        android:backgroundTint="#141D1D1B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_delegate"
            android:tint="#E0A24E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:text="@string/widget_preview_task_3"
            android:textColor="#1D1D1B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
