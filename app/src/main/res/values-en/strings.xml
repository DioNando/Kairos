    <string name="guide_set_theme_b">Light, dark or system. On Android 12+, Material You picks up your wallpaper colors.</string>
    <string name="guide_set_palette_t">Palettes</string>
    <string name="guide_set_palette_b">Choose the quadrant color palette, or create your own (4 custom colors).</string>
    <string name="guide_set_backup_t">Backup</string>
    <string name="guide_set_backup_b">Export all your data (tasks, subtasks, labels, settings) as JSON, and re-import it on another device.</string>
    <string name="guide_set_guide_t">This guide</string>
    <string name="guide_set_guide_b">You can hide the guide shortcut (the top icon) from Settings → Help; it stays reachable via “Open the guide”.</string>
