<?xml version="1.0" encoding="utf-8"?>
<!-- Parcours d'un quadrant : en-tête resserré au centre (‹ icône + compteur ›, le verbe est porté par
     la description d'accessibilité de l'icône) puis les tâches, chacune avec ✓.
     Glisser vers la gauche = quadrant suivant ; flèches pour aller dans les deux sens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quadrant_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/quad_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/wear_surface"
                android:contentDescription="@string/cd_prev_quadrant"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/quad_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/wear_do" />

                <TextView
                    android:id="@+id/quad_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/wear_on_bg_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/quad_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/wear_surface"
                android:contentDescription="@string/cd_next_quadrant"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/quad_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="24dp"
            android:text="@string/quadrant_empty"
            android:textColor="@color/wear_on_bg_variant"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/quad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/quad_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:textColor="@color/wear_on_bg_variant"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
