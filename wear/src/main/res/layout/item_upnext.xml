<?xml version="1.0" encoding="utf-8"?>
<!-- Une tâche « à suivre » : icône du quadrant + titre + pastille d'étiquette éventuelle
     (point coloré + nom tronqué). Inflatée par KairosLauncherActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_upnext"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingVertical="9dp">

    <ImageView
        android:id="@+id/upnext_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:src="@drawable/wear_do" />

    <TextView
        android:id="@+id/upnext_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/wear_on_bg"
        android:textSize="13sp" />

    <View
        android:id="@+id/upnext_label_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/dot"
        android:visibility="gone" />

    <!-- ✓ Terminer (envoyé au téléphone). -->
    <ImageButton
        android:id="@+id/upnext_done"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/wear_surface_high"
        android:contentDescription="@string/action_complete"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check" />
</LinearLayout>
