<?xml version="1.0" encoding="utf-8"?>
<!-- Un créneau du jour : barre colorée (quadrant) + horaire + titre. Inflaté par l'écran principal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_upnext"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/block_bar"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:background="@drawable/dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/block_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wear_on_bg_variant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wear_on_bg"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
